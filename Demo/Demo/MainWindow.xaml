<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Host" HorizontalAlignment="Left" Margin="178,322,0,0" VerticalAlignment="Top" Command="{Binding Path=StartGame}" CommandParameter="Host" Height="52" Width="180"/>
        <Button Content="Connect" HorizontalAlignment="Left" Margin="451,322,0,0" VerticalAlignment="Top" Command="{Binding Path=StartGame}" CommandParameter="Connect" Height="52" Width="180"/>
        <TextBox HorizontalAlignment="Center" Margin="0,286,0,0" TextWrapping="Wrap" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox HorizontalAlignment="Center" Margin="0,199,0,0" TextWrapping="Wrap" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox HorizontalAlignment="Center" Margin="0,93,0,0" TextWrapping="Wrap" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,72,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="sv-se" Text="Nickname"/></TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,178,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="sv-se" Text="Port"/></TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,265,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="sv-se" Text="IP address"/></TextBlock>
    </Grid>

</Window>
